{
  "openapi": "3.0.3",
  "info": {
    "title": "Learning Next.js API",
    "version": "1.0.0",
    "description": "Basic Route Handlers built while learning Next.js. Data is stored in memory and resets when the dev server restarts."
  },
  "servers": [{ "url": "http://localhost:3000", "description": "Local dev" }],
  "tags": [
    { "name": "Users" },
    { "name": "Posts" },
    { "name": "Dashboard" }
  ],
  "paths": {
    "/api/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List users",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Filter by name or email",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/User" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Create user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateUser" },
              "example": { "name": "Test User", "email": "test@example.com", "role": "user" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created user",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/users/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Users"],
        "summary": "Get user by ID",
        "responses": {
          "200": {
            "description": "User",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Update user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateUser" },
              "example": { "role": "admin" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Delete user",
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/posts": {
      "get": {
        "tags": ["Posts"],
        "summary": "List posts",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "description": "Only posts by this user",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of posts",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Post" } }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Posts"],
        "summary": "Create post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePost" },
              "example": { "title": "My first post", "body": "Hello world", "userId": 1 }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created post",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Post" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/posts/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Posts"],
        "summary": "Get post by ID",
        "responses": {
          "200": {
            "description": "Post",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Post" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Posts"],
        "summary": "Update post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdatePost" },
              "example": { "title": "Updated title" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated post",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Post" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Posts"],
        "summary": "Delete post",
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Get dashboard stats",
        "responses": {
          "200": {
            "description": "Stats",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DashboardStats" } } }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "example": 1 }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid input",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Not found",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id", "name", "email", "role"],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Alice Khan" },
          "email": { "type": "string", "format": "email", "example": "alice@example.com" },
          "role": { "type": "string", "enum": ["admin", "user"] }
        }
      },
      "CreateUser": {
        "type": "object",
        "required": ["name", "email"],
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["admin", "user"], "default": "user" }
        }
      },
      "UpdateUser": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["admin", "user"] }
        }
      },
      "Post": {
        "type": "object",
        "required": ["id", "title", "body", "userId", "createdAt"],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "title": { "type": "string", "example": "Getting started with Next.js" },
          "body": { "type": "string" },
          "userId": { "type": "integer", "example": 1 },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreatePost": {
        "type": "object",
        "required": ["title", "body", "userId"],
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" },
          "userId": { "type": "integer" }
        }
      },
      "UpdatePost": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" }
        }
      },
      "DashboardStats": {
        "type": "object",
        "required": ["totalUsers", "totalPosts", "admins", "latestPosts"],
        "properties": {
          "totalUsers": { "type": "integer" },
          "totalPosts": { "type": "integer" },
          "admins": { "type": "integer" },
          "latestPosts": { "type": "array", "items": { "$ref": "#/components/schemas/Post" } }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      }
    }
  }
}
